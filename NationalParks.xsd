<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<!-- Root element containing multiple national parks -->
	<xs:element name="NationalParks">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="NationalPark" minOccurs="1"
							maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>

							<!-- Each park has exactly one name -->
							<xs:element name="Name" type="xs:string"/>

							<!-- At least one phone number is required -->
							<xs:element name="Phone" type="xs:string"
										minOccurs="1"
										maxOccurs="unbounded"/>

							<!-- Each park has one address -->
							<xs:element name="Address">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Number" type="xs:int"/>
										<xs:element name="Street" type="xs:string"/>
										<xs:element name="City" type="xs:string"/>
										<xs:element name="State" type="xs:string"/>
										<xs:element name="Zip" type="xs:string"/>
									</xs:sequence>

									<!-- Required attribute -->
									<xs:attribute name="NearestAirport"
												  type="xs:string"
												  use="required"/>
								</xs:complexType>
							</xs:element>

						</xs:sequence>

						<!-- Optional rating attribute -->
						<xs:attribute name="Rating"
									  type="xs:decimal"
									  use="optional"/>

					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

</xs:schema>

